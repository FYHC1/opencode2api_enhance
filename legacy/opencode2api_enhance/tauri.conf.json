{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "opencode2api-manager",
  "version": "0.1.0",
  "identifier": "com.opencode2api.manager",
  "build": {
    "frontendDist": "static"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "opencode2api-manager",
        "width": 680,
        "height": 760,
        "minWidth": 600,
        "minHeight": 480,
        "resizable": true,
        "center": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": [],
    "icon": ["icons/icon.ico"]
  }
}
