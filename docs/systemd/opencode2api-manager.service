[Unit]
Description=opencode2api Manager (headless)
After=network.target

[Service]
Type=simple
User=opencode2api
# 二进制路径按实际安装位置修改
# headless 默认监听 :<port> 全接口；仅本机访问用 -listen 127.0.0.1；
# 服务器部署（内网/公网）需配合防火墙/前置 nginx 反代限制来源（管理 API 含启停实例等高权限操作，勿直接暴露公网）
ExecStart=/usr/local/bin/opencode2api -port 40000 -password CHANGE_ME -config /etc/opencode2api/config.json -listen 127.0.0.1
Restart=on-failure
RestartSec=5
# 数据目录（实例配置、运行态、日志均在此）
Environment=OPCODE2API_DATA_DIR=/var/lib/opencode2api
# 日志
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
