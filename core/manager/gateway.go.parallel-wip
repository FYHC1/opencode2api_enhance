// 统一网关管理（Rust gateway.rs 移植）：成员 = join_gateway 的 Running 实例；
// 生成路由配置 → spawn `opencode2api -gateway` 子进程；free_models 节流刷新。
package manager

import (
	"encoding/json"
	"os"
	"path/filepath"
	"sort"
	"sync"
	"time"
)

// GatewayManager 统一网关。
type GatewayManager struct {
	m      *Manager
	runner Runner

	mu        sync.Mutex
	pid       *int
	routeMode string
	ports     []uint16 // 已下发配置的成员端口
	lastCfg   []byte

	freeModels []string
	loading    bool
	lastFetch  time.Time
	lastOK     time.Time
	errMsg     string
}

// NewGatewayManager 构造网关管理器。
func NewGatewayManager(m *Manager, runner Runner) *GatewayManager {
	if runner == nil {
		runner = &realRunner{}
	}
	return &GatewayManager{m: m, runner: runner, routeMode: "round_robin"}
}

// gwDir 网关运行目录。
func (g *GatewayManager) gwDir() string { return filepath.Join(g.m.paths.RuntimeDir, "_unified-gateway") }

// SetRouteMode 设置路由模式（触发 resync）。
func (g *GatewayManager) SetRouteMode(mode string) {
	g.mu.Lock()
	g.routeMode = mode
	g.mu.Unlock()
}

// RouteMode 当前路由模式。
func (g *GatewayManager) RouteMode() string {
	g.mu.Lock()
	defer g.mu.Unlock()
	return g.routeMode
}

// members 收集成员（Running 且 join_gateway）→ 端口与名称。
func (g *GatewayManager) members() (ports []uint16, names map[uint16]string) {
	names = map[uint16]string{}
	for _, inst := range g.m.ListInstances() {
		if inst.Status.State == "Running" && inst.JoinGateway {
			ports = append(ports, inst.SingboxPort)
			names[inst.SingboxPort] = inst.Name
		}
	}
	sort.Slice(ports, func(i, j int) bool { return ports[i] < ports[j] })
	return
}

// Sync 依据当前实例成员同步网关（配置变化重启；无成员则停）。
func (g *GatewayManager) Sync() {
	g.mu.Lock()
	defer g.mu.Unlock()
	ports, names := g.members()
	g.ports = ports
	if len(ports) == 0 {
		g.stopLocked()
		return
	}
	cfg, err := g.m.buildRouterCfg(ports, names, g.routeMode)
	if err != nil {
		g.errMsg = err.Error()
		return
	}
	changed := string(cfg) != string(g.lastCfg)
	if changed {
		g.lastCfg = cfg
		if g.pid != nil {
			g.stopLocked()
		}
	}
	if g.pid == nil {
		if err := g.startLocked(cfg); err != nil {
			g.errMsg = err.Error()
		}
	}
}

// startLocked spawn `-gateway` 子进程（cwd = gwDir，stats 落盘于此）。
func (g *GatewayManager) startLocked(cfg []byte) error {
	dir := g.gwDir()
	if err := os.MkdirAll(filepath.Join(dir, "logs"), 0o755); err != nil {
		return err
	}
	if err := os.WriteFile(filepath.Join(dir, "opencode2api.json"), cfg, 0o644); err != nil {
		return err
	}
	pid, err := g.runner.Start(ExecSpec{
		Bin:      g.m.binPath("opencode2api"),
		Args:     []string{"-port", itoa(unifiedGatewayPort), "-config", filepath.Join(dir, "opencode2api.json"), "-password", unifiedGatewayKey, "-gateway"},
		Dir:      dir,
		LogOut:   filepath.Join(dir, "logs", "opencode2api.out.log"),
		LogErr:   filepath.Join(dir, "logs", "opencode2api.err.log"),
		NoWindow: true,
	})
	if err != nil {
		return err
	}
	g.pid = &pid
	return nil
}

// stopLocked 停网关。
func (g *GatewayManager) stopLocked() {
	if g.pid != nil {
		_ = g.runner.Kill(*g.pid)
		g.pid = nil
	}
	g.ports = nil
	g.lastCfg = nil
	g.freeModels = nil
}

// Stop 停止网关（对外）。
func (g *GatewayManager) Stop() {
	g.mu.Lock()
	defer g.mu.Unlock()
	g.stopLocked()
}

// GatewayStatus 网关状态（前端契约）。
type GatewayStatus struct {
	Running            bool     `json:"running"`
	Address            string   `json:"address"`
	Port               uint16   `json:"port"`
	APIKey             string   `json:"api_key"`
	RunningInstances   int      `json:"running_instances"`
	TotalInstances     int      `json:"total_instances"`
	Message            string   `json:"message"`
	RouteMode          string   `json:"route_mode"`
	FreeModels         []string `json:"free_models"`
	FreeModelsUpdated  int64    `json:"free_models_updated_at,omitempty"`
	FreeModelsError    string   `json:"free_models_error,omitempty"`
}

// Status 网关状态快照（无成员且未运行 → 尝试启动）。
func (g *GatewayManager) Status() GatewayStatus {
	g.mu.Lock()
	defer g.mu.Unlock()
	st := GatewayStatus{
		Port:     unifiedGatewayPort,
		APIKey:   unifiedGatewayKey,
		RouteMode: g.routeMode,
		Address:  "http://127.0.0.1:18080/v1",
	}
	for _, inst := range g.m.ListInstances() {
		st.TotalInstances++
		if inst.Status.State == "Running" {
			st.RunningInstances++
		}
	}
	if len(g.ports) == 0 {
		ports, _ := g.members()
		if len(ports) > 0 && g.pid == nil {
			g.mu.Unlock()
			g.Sync()
			g.mu.Lock()
		}
	}
	st.Running = g.pid != nil
	st.FreeModels = append([]string(nil), g.freeModels...)
	if !g.lastOK.IsZero() {
		st.FreeModelsUpdated = g.lastOK.UnixMilli()
	}
	st.FreeModelsError = g.errMsg
	if g.pid != nil {
		st.Message = "running"
	} else if len(g.ports) == 0 {
		st.Message = "无成员实例"
	} else {
		st.Message = "未运行"
	}
	return st
}

// RefreshFreeModels 节流刷新免费模型（未加载 / 距上次 ≥10s 且成功 ≥60s）。
func (g *GatewayManager) RefreshFreeModels() {
	g.mu.Lock()
	if g.loading {
		g.mu.Unlock()
		return
	}
	if !g.lastFetch.IsZero() && time.Since(g.lastFetch) < 10*time.Second {
		g.mu.Unlock()
		return
	}
	if !g.lastOK.IsZero() && time.Since(g.lastOK) < 60*time.Second {
		g.mu.Unlock()
		return
	}
	g.loading = true
	g.mu.Unlock()

	status, body, err := httpGetJSON(unifiedGatewayPort, "/v1/models", 20*time.Second, unifiedGatewayKey)
	g.mu.Lock()
	g.loading = false
	g.lastFetch = time.Now()
	if err != nil || status < 200 || status >= 300 {
		g.errMsg = "免费模型刷新失败"
		g.mu.Unlock()
		return
	}
	var payload struct {
		Data []struct {
			ID string `json:"id"`
		} `json:"data"`
	}
	if json.Unmarshal(body, &payload) != nil {
		g.errMsg = "免费模型解析失败"
		g.mu.Unlock()
		return
	}
	seen := map[string]bool{}
	var ids []string
	for _, d := range payload.Data {
		if d.ID != "" && !seen[d.ID] {
			seen[d.ID] = true
			ids = append(ids, d.ID)
		}
	}
	sort.Strings(ids)
	g.freeModels = ids
	g.lastOK = time.Now()
	g.errMsg = ""
	g.mu.Unlock()
}